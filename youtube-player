											local isPlaying = videoPlayer.isPlaying()
											if not isPlaying and searchLayout.getVisibility() == View.GONE then
												searchLayout.setVisibility(View.VISIBLE)
												service.speak("Video stopped. Search interface restored.")
											end
										else
											if searchLayout.getVisibility() == View.GONE then
												searchLayout.setVisibility(View.VISIBLE)
												service.speak("Playback ended. Search interface restored.")
											end
										end
									end
									}, 10000)
						end

						function searchHandler(prompt)
							vibrate()
							local query = prompt or textInput.text
							if #query == 0 then
								updateResultText("Please enter a search keyword.")
								return
							end

							addSearchHistory(query)

							resetUi()
							updateResultText("Searching, please wait...")

							searchYoutube(query, function(jsonData, error)
								if error then
									updateResultText("Error: " .. error)
								else
									local status, data = pcall(cjson.decode, jsonData)

									if status and data.status and type(data.result) == "table" and #data.result > 0 then

										currentSortOrder = "default"
										currentFilter = "none"

										updateResultList(data.result)

									else
										local err_msg = (data and data.message) or "No results found."
										updateResultText("API Error: " .. err_msg)
									end
								end
							end)
					end

					searchButton.onClick = function()
					searchHandler()
				end

				function playVideoByIndex(index, quality, startPosition)
					vibrate()
					if videoPlayer then videoPlayer.stopPlayback() end
						stopUpdateTime()
						currentMediaPlayer = nil
						if not videoQueue[index+1] then return end
							currentPlayingIndex = index
							local item = videoQueue[index+1]
							local videoTitle = item.title
							currentSelectedURL = item.videoId
							currentSelectedQuality = quality or defaultQuality or "720"
							local cleanID = tostring(currentSelectedURL):gsub("%s+", "")
							local targetUrl = "https://youtube.com/watch?v=" .. cleanID
							local mediaType, mediaQuality
							if isModeVideo then
								mediaType = "mp4"
								mediaQuality = tostring(currentSelectedQuality):gsub("p", "")
							else
								mediaType = "mp3"
								mediaQuality = "128"
							end
							local playUrl = string.format(
								"https://yogalabs.vercel.app/api/download/ytdl2?url=%s&type=%s&quality=%s",
								Uri.encode(targetUrl),
								mediaType,
								mediaQuality
								)
							updateResultText("Meminta link " .. mediaType:upper() .. " (" .. mediaQuality .. ")...")
							apiRequest(playUrl, function(jsonData, error)
								if error then
									updateResultText("Gagal: " .. error)
									return
								end
								local status, data = pcall(cjson.decode, jsonData)
								if status and data.success and data.result and data.result.download then
									local directLink = data.result.download
									timeHandler.post(Runnable{
											run = function()
											videoPlayer.setVisibility(View.VISIBLE)
											timeText.setVisibility(View.VISIBLE)
											seekBar.setVisibility(View.VISIBLE)
											controlButtonsLayout.setVisibility(View.VISIBLE)
											navigationButtonsLayout.setVisibility(View.VISIBLE)
											queueActionsLayout.setVisibility(View.VISIBLE)
											downloadVideoButton.setEnabled(true)
											downloadAudioButton.setEnabled(true)
											transcriptButton.setEnabled(true)
											videoPlayer.setVideoURI(Uri.parse(directLink))
											videoPlayer.requestFocus()
											videoPlayer.setOnPreparedListener(MediaPlayer.OnPreparedListener{
													onPrepared = function(mp)
													currentMediaPlayer = mp
													mp.setLooping(isLooping)
													applyPlaybackParams(currentSpeed, currentPitch)
													if startPosition and startPosition > 0 then
														videoPlayer.seekTo(startPosition)
													end
													if requestAudioFocus() == 1 then
														videoPlayer.start()
														playPauseButton.text = "Pause"
													end
													searchLayout.setVisibility(View.GONE)
													startUpdateTime()
													service.speak("Memutar " .. mediaType:upper() .. ": " .. videoTitle)
												end
												})

										videoPlayer.setOnCompletionListener(MediaPlayer.OnCompletionListener{
												onCompletion = function(mp)
												if mp.isLooping() then return end
													updateResultText("Selesai.")
													if isAutoNext and currentPlayingIndex < (#videoQueue - 1) then
														playVideoByIndex(currentPlayingIndex + 1, currentSelectedQuality)
													else
														autoShowSearchLayout()
													end
												end
												})
									end
									})
						else
							updateResultText("API Error: Link download tidak ditemukan.")
						end
					end)
			end

			function handleDownload(type)
				vibrate()

				if not currentSelectedURL or not currentSelectedQuality then
					updateResultText("No video/quality selected for download.")
					return
				end

				local downloadType = type
				local selectedQuality = currentSelectedQuality
				local fileExtension = (type == "video") and "mp4" or "mp3"

				updateResultText("Preparing download for " .. downloadType .. " (" .. fileExtension .. ")...")

				getDownloadLink(currentSelectedURL, downloadType, selectedQuality, function(jsonData, error)
					timeHandler.post(Runnable { run = function()
							if error then
								updateResultText("Download error: " .. error)
								return
							end

							local status, data = pcall(cjson.decode, jsonData)
							if status and data.status == true and data.data and data.data.url then
								local downloadUrl = data.data.url
								local fileName = data.data.filename or ("youtube_" .. downloadType .. "_" .. selectedQuality .. "p." .. fileExtension)

								if not fileName:match("%." .. fileExtension .. "$") then
									fileName = fileName .. "." .. fileExtension
								end

								startDownload(downloadUrl, "Downloading " .. downloadType:upper(), fileName)
							else
								updateResultText("Failed to get download link. Format/Quality may not exist.")
							end
						end})
			end)
	end

	function startDownload(url, title, fileName)
		pcall(function()
			local dm = activity.getSystemService(Context.DOWNLOAD_SERVICE)
			local request = DownloadManager.Request(Uri.parse(url))

			request.setNotificationVisibility(DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED)
			request.setTitle(title)
			request.setDescription("Downloading: " .. fileName)
			request.setDestinationInExternalPublicDir(Environment.DIRECTORY_DOWNLOADS, fileName)
			request.setAllowedOverMetered(true)
			request.setAllowedOverRoaming(true)

			dm.enqueue(request)
			service.speak("Starting download: " .. title)

		end)
end

