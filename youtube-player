function parseViews(viewStr)
	local v = viewStr:match("^([%d%.]+)") or "0"
	local modifier = viewStr:match("([KMTB])$")
	v = tonumber(v) or 0
	if modifier == 'K' then return v * 1000 end
		if modifier == 'M' then return v * 1000000 end
			return v
		end

		function parseDurationToSeconds(durationStr)
			if not durationStr or durationStr == "00:00" or durationStr == "" then
				return 0
			end

			local parts = {durationStr:match("^(%d*):?(%d*):?(%d*)$")}

			local function toNum(str)
			return tonumber(str) or 0
		end

		local durationSec = 0

		if #parts == 3 then
			durationSec = (toNum(parts[1]) * 3600) + (toNum(parts[2]) * 60) + toNum(parts[3])
		elseif #parts == 2 then
			durationSec = (toNum(parts[1]) * 60) + toNum(parts[2])
		elseif #parts == 1 then
			durationSec = toNum(parts[1])
		else
			durationSec = 0
		end

		return durationSec
	end

	function applySortAndFilter(data, sortOrder, filter)
		if not data or #data == 0 then return {} end

			local processingData = {}
			for _, item in ipairs(data) do
				table.insert(processingData, item)
				item.durationSec = parseDurationToSeconds(item.timestamp or "00:00")
			end

			local filteredData = {}

			for _, item in ipairs(processingData) do
				local passedFilter = true
				if filter == ">10m" then
					if item.durationSec < 600 then passedFilter = false end
					elseif filter == "<5m" then
						if item.durationSec > 300 then passedFilter = false end
						end

						if passedFilter then
							table.insert(filteredData, item)
						end
					end

					if sortOrder == "views" then
						table.sort(filteredData, function(a, b)
							return parseViews(a.views or "0") > parseViews(b.views or "0")
						end)
				elseif sortOrder == "duration" then
					table.sort(filteredData, function(a, b)
						return a.durationSec > b.durationSec
					end)
			end

			return filteredData
		end

		function updateResultList(results)
