micSearchButton.onClick = function()
vibrate()
local sr = SpeechRecognizer.createSpeechRecognizer(activity)

resultText.text = "Listening..."

sr.setRecognitionListener(RecognitionListener{
		onReadyForSpeech=function(params)
		resultText.text = "Listening..."
		end,
		onResults = function(results)
		vibrate()
		local data = results.getParcelableArrayList(SpeechRecognizer.RESULTS_RECOGNITION)
		if data and data.size() > 0 then
			local spokenText = data.get(0)

			timeHandler.post(Runnable{
					run = function()
					searchHandler(spokenText)
				end
				})
		else
			resultText.text = "Could not recognize speech."
		end
		pcall(function() sr.destroy() end)
		end,
		onError = function(error)
		vibrate()
		resultText.text = "Recognition error: " .. tostring(error)
		pcall(function() sr.destroy() end)
		end,
		})

local intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH)
intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
intent.putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 1)

intent.putExtra(RecognizerIntent.EXTRA_LANGUAGE, "en-US")

sr.startListening(intent)
end

