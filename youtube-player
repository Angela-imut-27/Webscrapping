clearQueueButton.onClick = function()
vibrate()
local oldQueueSize = #videoQueue
videoQueue = {}
currentPlayingIndex = nil

if videoPlayer and videoPlayer.isPlaying() then
	videoPlayer.stopPlayback()
	stopUpdateTime()
	abandonAudioFocus()
end

resetUi()
queueActionsLayout.setVisibility(View.GONE)
updateResultText(string.format("Cleared %d items from the playback queue.", oldQueueSize))
end

addToQueueButton.onClick = function()
vibrate()
if #currentDisplayResults > 0 then
	videoQueue = currentDisplayResults
	currentPlayingIndex = 0
	resultsList.setVisibility(View.GONE)
	resultActionsLayout.setVisibility(View.GONE)

	playVideoByIndex(currentPlayingIndex, defaultQuality)
else
	service.speak("No results to add to queue.")
end
end

addToQueueSingleButton.onClick = function()
vibrate()
if currentPlayingIndex == nil or not videoQueue[currentPlayingIndex + 1] then
	service.speak("No video currently playing to add to the queue.")
	return
end

local item = videoQueue[currentPlayingIndex + 1]

table.insert(videoQueue, {
		title = item.title,
		url = item.url,
		timestamp = item.timestamp,
		views = item.views
		})

local newIndex = #videoQueue
service.speak(string.format("Added '%s' to the end of the queue. New position is %d.", item.title, newIndex))
end

resultsList.onItemClick = function(parent, view, position, id)
vibrate()
local selectedItem = currentDisplayResults[position + 1]

if not selectedItem then
	service.speak("Invalid item.")
	return
end

videoQueue = {selectedItem}
currentPlayingIndex = 0

playVideoByIndex(currentPlayingIndex, defaultQuality)
end

previousButton.onClick = function()
vibrate()
if currentPlayingIndex ~= nil and currentPlayingIndex > 0 then
	currentPlayingIndex = currentPlayingIndex - 1
	playVideoByIndex(currentPlayingIndex, currentSelectedQuality)
else
	service.speak("Already at the first video in the queue.")
end
end

nextButton.onClick = function()
vibrate()
if currentPlayingIndex ~= nil and currentPlayingIndex < (#videoQueue - 1) then
	currentPlayingIndex = currentPlayingIndex + 1
	playVideoByIndex(currentPlayingIndex, currentSelectedQuality)
else
	service.speak("Already at the last video in the queue.")
end
end

rewindButton.onClick = function()
vibrate()
if videoPlayer and videoPlayer.canSeekBackward() then
	local currentPos = videoPlayer.getCurrentPosition()
	local newPos = math.max(0, currentPos - 10000)
	videoPlayer.seekTo(newPos)
	service.speak("Rewound 10 seconds")
else
	service.speak("Cannot rewind")
end
end

forwardButton.onClick = function()
vibrate()
if videoPlayer and videoPlayer.canSeekForward() then
	local currentPos = videoPlayer.getCurrentPosition()
	local duration = videoPlayer.getDuration()
	local newPos = math.min(duration, currentPos + 10000)
	videoPlayer.seekTo(newPos)
	service.speak("Forwarded 10 seconds")
else
	service.speak("Cannot forward")
end
end

replayButton.onClick = function()
vibrate()
if videoPlayer and videoPlayer.getDuration() > 0 then
	videoPlayer.seekTo(1)
	local focusResult = requestAudioFocus()
	if focusResult == AudioManager.AUDIOFOCUS_REQUEST_GRANTED then
		videoPlayer.start()
		applyPlaybackParams(currentSpeed, currentPitch)
		applyVolumeBoost(currentVolumeBoost)
		playPauseButton.text = "Pause"
	else
		service.speak("Cannot replay, audio focus denied.")
	end

	searchLayout.setVisibility(View.GONE)
	startUpdateTime()
end
end

playPauseButton.onClick = function()
vibrate()
if videoPlayer and videoPlayer.isPlaying() then
	videoPlayer.pause()
	playPauseButton.text = "Play"
	service.speak("Paused")

	abandonAudioFocus()

	searchLayout.setVisibility(View.VISIBLE)
	stopUpdateTime()
else
	local focusResult = requestAudioFocus()
	if focusResult == AudioManager.AUDIOFOCUS_REQUEST_GRANTED then
		videoPlayer.start()
		applyPlaybackParams(currentSpeed, currentPitch)
		applyVolumeBoost(currentVolumeBoost)
		playPauseButton.text = "Pause"
		service.speak("Playing")
	else
		service.speak("Cannot play, audio focus denied.")
	end

	searchLayout.setVisibility(View.GONE)
	startUpdateTime()
end
end

seekBar.setOnSeekBarChangeListener(SeekBar.OnSeekBarChangeListener{
		onProgressChanged = function(sb, progress, fromUser)
		if fromUser then
			local currentMinutes = math.floor(progress / 60000)
			local currentSeconds = math.floor((progress % 60000) / 1000)
			local currentStr = string.format("%02d:%02d", currentMinutes, currentSeconds)
			timeText.text = currentStr .. " / " .. string.sub(timeText.text, 9)
		end
		end,
		onStartTrackingTouch = function(sb)
		stopUpdateTime()
		end,
		onStopTrackingTouch = function(sb)
		vibrate()
		local newPosition = sb.getProgress()
		videoPlayer.seekTo(newPosition)
		service.speak("Seeked to " .. timeText.text)
		startUpdateTime()
		end
		})

