							navigationButtonsLayout.setVisibility(View.GONE)

							if searchLayout.getVisibility() == View.GONE then
								searchLayout.setVisibility(View.VISIBLE)
							end

							currentMediaPlayer = nil
							abandonAudioFocus()

							currentResults = nil
							currentDisplayResults = {}
							currentPlayingIndex = nil
							currentSelectedURL = nil
							currentSelectedQuality = nil

							playPauseButton.text = "Play"
							timeText.text = "00:00 / 00:00"
							stopUpdateTime()
