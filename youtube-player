function loadHistory()
	local historyJson = prefs.getString("searchHistory", "[]")
	local status, history = pcall(cjson.decode, historyJson)
	if status and type(history) == "table" then
		searchHistory = history
	else
		searchHistory = {}
	end
end

function saveHistory()
	local editor = prefs.edit()
	editor.putString("searchHistory", cjson.encode(searchHistory))
	editor.apply()
end

function addSearchHistory(query)
	if not query or #query == 0 then return end

		for i = #searchHistory, 1, -1 do
			if searchHistory[i] == query then
				table.remove(searchHistory, i)
			end
		end

		table.insert(searchHistory, 1, query)

		while #searchHistory > MAX_HISTORY do
			table.remove(searchHistory)
		end
		saveHistory()
	end

	function loadSettings()
		currentSpeed = prefs.getFloat("speed", 1.0)
		currentPitch = prefs.getFloat("pitch", 1.0)
		currentVolumeBoost = prefs.getFloat("volumeBoost", 1.0)
		defaultQuality = prefs.getString("defaultQuality", "720")

		isLooping = prefs.getBoolean("isLooping", false)
		isModeVideo = prefs.getBoolean("isModeVideo", false)
		isAutoNext = prefs.getBoolean("isAutoNext", true)
		autoShowSearch = prefs.getBoolean("autoShowSearch", true)

		loadHistory()
	end

	function saveSettings()
		local editor = prefs.edit()
		editor.putFloat("speed", currentSpeed)
		editor.putFloat("pitch", currentPitch)
		editor.putFloat("volumeBoost", currentVolumeBoost)
		editor.putString("defaultQuality", defaultQuality)

		editor.putBoolean("isLooping", isLooping)
		editor.putBoolean("isModeVideo", isModeVideo)
		editor.putBoolean("isAutoNext", isAutoNext)
		editor.putBoolean("autoShowSearch", autoShowSearch)

		editor.apply()
	end

	function vibrate()
		local vibrator = activity.getSystemService(Context.VIBRATOR_SERVICE)
		if vibrator and vibrator.hasVibrator() then
			vibrator.vibrate(35)
		end
	end

	function requestAudioFocus()
		if audioManager == nil then return AudioManager.AUDIOFOCUS_REQUEST_FAILED end

			local audioAttributes = AudioAttributes.Builder()
			.setUsage(AudioAttributes.USAGE_MEDIA)
			.setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
			.build()

			if audioFocusChangeListener == nil then
				audioFocusChangeListener = AudioManager.OnAudioFocusChangeListener {
					onAudioFocusChange = function(focusChange)
					timeHandler.post(Runnable { run = function()
							if currentMediaPlayer == nil then return end

								if focusChange == AudioManager.AUDIOFOCUS_LOSS_TRANSIENT or
									focusChange == AudioManager.AUDIOFOCUS_LOSS_TRANSIENT_CAN_DUCK or
									focusChange == AudioManager.AUDIOFOCUS_LOSS then
									if currentMediaPlayer and currentMediaPlayer.isPlaying() then
										videoPlayer.pause()
										playPauseButton.text = "Play"
										service.speak("Audio focus lost, paused.")
									end
								elseif focusChange == AudioManager.AUDIOFOCUS_GAIN then
									if currentMediaPlayer and not currentMediaPlayer.isPlaying() and (playPauseButton.text == "Play") then
										videoPlayer.start()
										playPauseButton.text = "Pause"
										applyPlaybackParams(currentSpeed, currentPitch)
										applyVolumeBoost(currentVolumeBoost)
										service.speak("Audio focus restored, resuming playback.")
									end
								end
							end})
				end
				}
		end

		focusRequest = AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN)
		.setAudioAttributes(audioAttributes)
		.setOnAudioFocusChangeListener(audioFocusChangeListener)
		.build()

		local result = audioManager.requestAudioFocus(focusRequest)
		return result
	end

	function abandonAudioFocus()
		if audioManager and focusRequest then
			audioManager.abandonAudioFocusRequest(focusRequest)
		end
	end

	function applyPlaybackParams(speed, pitch)

		abandonAudioFocus()

		local success = false
		if currentMediaPlayer then
			local params = PlaybackParams()
			params.setSpeed(speed)
			params.setPitch(pitch)

			pcall(function()
				currentMediaPlayer.setPlaybackParams(params)
				success = true
			end)
	end

	currentSpeed = speed
	currentPitch = pitch

	if success then
		service.speak(string.format("Applied. Speed: %.2fx, Pitch: %.2fx", speed, pitch))
	else
		service.speak(string.format("Saved TEMPORARY settings: Speed: %.2fx, Pitch: %.2fx. Please Play a new video.", speed, pitch))
	end

	if currentMediaPlayer and currentMediaPlayer.isPlaying() then
		requestAudioFocus()
	end
end

function applyVolumeBoost(boost)
	if currentMediaPlayer then
		pcall(function()
			currentMediaPlayer.setVolume(boost, boost)
		end)
end
currentVolumeBoost = boost
service.speak(string.format("Applied volume boost: %.1fx", boost))
end

function apiRequest(url, callback)
	if not url or url == "" then
		callback(nil, "Invalid URL parameter")
		return
	end

	loadingBar.setVisibility(View.VISIBLE)

	Thread(Runnable {
			run = function()
			Http.get(url, function(code, content)
				timeHandler.post(Runnable { run = function()
						loadingBar.setVisibility(View.GONE)
						if code ~= 200 then
							callback(nil, "HTTP Error: " .. code)
							return
						end
						callback(content, nil)
					end})
			end)
		end
		}).start()
end

function searchYoutube(prompt, callback)
	if not prompt or prompt == "" then
		callback(nil, "Invalid parameter")
		return
	end
	local url = "https://api.ootaizumi.web.id/search/youtube?query=" .. Uri.encode(prompt)
	apiRequest(url, callback)
end

function getDownloadLink(youtubeUrl, type, quality, callback)
	if not youtubeUrl or not type or not quality then
		callback(nil, "Invalid parameter")
		return
	end

	local url = "https://api.arincy.site/api/youtube?url=" .. Uri.encode(youtubeUrl) .. "&type=" .. Uri.encode(type) .. "&quality=" .. Uri.encode(quality)
	apiRequest(url, callback)
end

function getTranscript(youtubeUrl, callback)
	if not youtubeUrl or youtubeUrl == "" then
		callback(nil, "Invalid parameter: Missing YouTube URL (ID)")
		return
	end

	local request_url = "https://fetch-youtube-transcript-api.vercel.app/transcript/?url=" .. Uri.encode(youtubeUrl)

	loadingBar.setVisibility(View.VISIBLE)

	Thread(Runnable {
			run = function()
			Http.get(request_url, function(code, content)
				timeHandler.post(Runnable { run = function()
						loadingBar.setVisibility(View.GONE)

						if code ~= 200 then
							callback(nil, "HTTP Error: " .. code .. " - Video may lack subtitles or API may be faulty.")
							return
						end
						local status, decoded_data = pcall(cjson.decode, content)
						if not status then
							callback(nil, "Could not parse server response: " .. tostring(decoded_data))
							return
						end
						if decoded_data.success == true and decoded_data.transcripts then
							local transcription = decoded_data.transcripts
							callback(transcription, nil)
						else
							local error_msg = decoded_data.transcripts or decoded_data.error or "Unknown API error. Video may not support transcription."
							callback(nil, "API Error: " .. error_msg)
						end
					end})
			end)
		end
		}).start()
end

